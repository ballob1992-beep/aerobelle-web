{%- liquid
  assign cdn = 'https://cdn.shopify.com/s/files/1/0905/0089/0960/files/'
  assign is_warranty = false
  if product.handle == 'kiterjesztett-garancia'
    assign is_warranty = true
  endif
  assign v = product.selected_or_first_available_variant
-%}
{%- render 'ab-page-style' -%}
<style>
.abd-main{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:48px;align-items:start;padding-top:32px;padding-bottom:56px}
.abd-cover{border-radius:20px;overflow:hidden;background:#FFFFFF;box-shadow:0 18px 40px rgba(43,43,43,.12)}
.abd-cover img{width:100%;display:block}
.abd-desc{font-size:16.5px;line-height:1.65;color:#4A433E}
.abd-desc p{margin:0 0 12px}.abd-desc ul,.abd-desc ol{margin:0 0 12px;padding-left:20px}.abd-desc li{margin-bottom:4px}
.abd-up{background:#2B2B2B;color:#F9F4F0;border-radius:18px;padding:20px;display:flex;gap:16px;align-items:center}
.abd-up img{width:84px;height:84px;border-radius:12px;object-fit:cover;flex:none}
@media (max-width:899px){.abd-main{grid-template-columns:1fr;gap:28px}.abd-cover{max-width:360px;margin:0 auto}}
</style>
<div class="abh">
<section class="wrap abd-main">
  <div class="abd-cover">
    {%- if product.featured_media -%}<img src="{{ product.featured_media | image_url: width: 900 }}" alt="{{ product.title | escape }}" width="900" height="1200">{%- endif -%}
  </div>
  <div style="display:flex;flex-direction:column;gap:18px">
    <div>
      <div class="eyebrow">{% if is_warranty %}Kiegészítő a BD22-höz{% else %}AeroBelle Hajkódex · e-book{% endif %}</div>
      <h1 style="font-size:clamp(32px,4.4vw,50px);margin-top:8px !important">{{ product.title }}</h1>
      <div style="font-size:28px;font-weight:700;margin-top:12px">{{ v.price | money_without_trailing_zeros }}</div>
    </div>

    {%- if is_warranty -%}
      <div style="background:#FFF3EE;border:2px solid #FE6C3B;border-radius:16px;padding:16px 18px;font-size:16px;line-height:1.5"><b>Csak a hajformázóval együtt vehető meg.</b> A BD22 oldalán a „Csak a készülék” mellé pipálhatod ki, a Teljes csomagban pedig ajándékba jár.</div>
      <a class="btn" href="/products/aerobelle-bd22">Tovább a hajformázóhoz →</a>
    {%- else -%}
      <button type="button" class="btn" data-abk-add="{{ v.id }}" style="width:100%;min-height:60px">Kosárba – {{ v.price | money_without_trailing_zeros }}</button>
      <div style="display:flex;flex-wrap:wrap;gap:8px 18px;font-size:14px;color:#5C534C"><span>✓ PDF, azonnal e-mailben</span><span>✓ Nincs szállítás, nincs várakozás</span><span>✓ Kártya, Apple Pay, Google Pay, PayPal</span></div>
    {%- endif -%}

    <div class="abd-desc">{{ product.description }}</div>

    {%- unless is_warranty -%}
    <a class="abd-up" href="/products/aerobelle-bd22" style="text-decoration:none;color:#F9F4F0">
      <img src="{{ cdn }}aerobelle-csomag-flatlay.jpg?width=200" alt="" loading="lazy">
      <span style="font-size:15px;line-height:1.5"><b style="color:#FE6C3B">Tipp:</b> a hajformázó Teljes csomagjában mindhárom Hajkódex kötet ajándék – oktatóvideókkal és 3 év garanciával együtt. <u>Megnézem →</u></span>
    </a>
    {%- endunless -%}
  </div>
</section>

{%- unless is_warranty -%}
<section style="background:#FFFFFF">
  <div class="wrap sec">
    <h2 style="font-size:clamp(28px,3.6vw,40px);margin-bottom:24px !important">A sorozat további kötetei</h2>
    {%- render 'ab-hajkodex', exclude: product.handle -%}
  </div>
</section>
{%- endunless -%}
</div>
{% schema %}
{ "name": "AeroBelle e-book", "settings": [], "presets": [{ "name": "AeroBelle e-book" }] }
{% endschema %}
