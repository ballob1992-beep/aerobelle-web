<style>
.abp-main{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:48px;align-items:start;padding-top:28px;padding-bottom:64px}
.abp-gal-main{position:relative;border-radius:22px;overflow:hidden;background:#FFFFFF;aspect-ratio:1/1}
.abp-gal-main img{width:100%;height:100%;object-fit:cover;display:block}
.abp-thumbs{display:flex;gap:10px;margin-top:12px;overflow-x:auto;padding-bottom:4px;scrollbar-width:none}.abp-thumbs::-webkit-scrollbar{display:none}
.abp-thumbs button{flex:none;width:76px;height:76px;border-radius:12px;overflow:hidden;border:2px solid transparent;padding:0;background:#FFFFFF;cursor:pointer}
.abp-thumbs button[aria-current="true"]{border-color:#FE6C3B}
.abp-thumbs img{width:100%;height:100%;object-fit:cover;display:block}
.abp-buy{position:sticky;top:96px;display:flex;flex-direction:column;gap:16px}
.abp-opt{display:block;position:relative;border:2px solid #E3D9D0;border-radius:18px;background:#FFFFFF;padding:18px 18px 16px;cursor:pointer;transition:border-color .15s,box-shadow .15s}
.abp-opt:has(input:checked){border-color:#FE6C3B;box-shadow:0 0 0 4px rgba(254,108,59,.14)}
.abp-opt input[type=radio]{position:absolute;opacity:0;pointer-events:none}
.abp-opt-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.abp-radio{flex:none;width:22px;height:22px;border-radius:50%;border:2px solid #CFC6BE;margin-top:2px;display:flex;align-items:center;justify-content:center}
.abp-opt:has(input:checked) .abp-radio{border-color:#FE6C3B}
.abp-opt:has(input:checked) .abp-radio::after{content:"";width:12px;height:12px;border-radius:50%;background:#FE6C3B}
.abp-badge{position:absolute;top:-12px;left:18px;background:#2B2B2B;color:#F9F4F0;font-size:12px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;padding:4px 10px;border-radius:999px}
.abp-incl{list-style:none;margin:12px 0 0;padding:0;display:flex;flex-direction:column;gap:6px;font-size:14.5px}
.abp-incl li{display:flex;gap:8px;align-items:flex-start}
.abp-incl svg{flex:none;margin-top:3px}
.abp-addons{display:none;margin-top:14px;padding-top:14px;border-top:1px dashed #E3D9D0;flex-direction:column;gap:10px}
.abp-opt:has(input:checked) .abp-addons{display:flex}
.abp-addon{display:flex;gap:10px;align-items:center;font-size:14.5px;cursor:pointer}
.abp-addon input{width:20px;height:20px;accent-color:#FE6C3B;flex:none;margin:0}
.abp-addon img{width:40px;height:40px;border-radius:8px;object-fit:cover;flex:none}
.abp-addon span{flex:1}
.abp-cta{width:100%;min-height:62px;font-size:17px}
.abp-cta[disabled]{opacity:.6;cursor:wait}
.abp-trust{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.abp-trust div{background:#FFFFFF;border-radius:14px;padding:12px 14px;font-size:13.5px;line-height:1.35;display:flex;gap:10px;align-items:center}
.abp-trust b{display:block;font-size:14.5px}
.abp-sticky{position:fixed;left:0;right:0;bottom:0;z-index:40;background:#2B2B2B;color:#F9F4F0;padding:10px 16px calc(10px + env(safe-area-inset-bottom));display:none;align-items:center;justify-content:space-between;gap:12px;transform:translateY(110%);transition:transform .25s}
.abp-sticky.on{transform:none}
.abp-sticky .btn{min-height:48px;padding:0 20px;font-size:14px}
.abp-spec{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:0 32px}
.abp-spec div{display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid #E3D9D0;font-size:15px}
.abp-spec span:first-child{color:#5C534C}
.abp-heads{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px}
.abp-heads figure{margin:0;background:#FFFFFF;border-radius:16px;overflow:hidden}
.abp-heads img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block}
.abp-heads figcaption{padding:12px 14px 14px;font-size:14px;line-height:1.4}
.abp-books{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.abp-books figure{margin:0;background:#FFFFFF;border-radius:18px;padding:16px;display:flex;flex-direction:column;gap:10px}
.abp-books img{width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:10px;display:block}
@media (max-width:989px){.abp-main{grid-template-columns:1fr;gap:28px}.abp-buy{position:static}.abp-heads{grid-template-columns:repeat(2,minmax(0,1fr))}.abp-books{grid-template-columns:1fr 1fr 1fr;gap:10px}.abp-spec{grid-template-columns:1fr}.abp-sticky{display:flex}}
@media (max-width:560px){.abp-books{grid-template-columns:1fr}.abp-books figure{flex-direction:row;align-items:center}.abp-books img{width:90px;flex:none}}
</style>
