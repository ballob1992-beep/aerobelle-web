{%- comment -%}
  AeroBelle LP3 – oktatóvideós feliratkozó oldal (Dorka).
  Önálló szekció: saját stílus (.ab-lp3 alatt), Shopify customer űrlap, címkék: lp3, oktatovideo.
{%- endcomment -%}

{%- liquid
  assign cdn = 'https://cdn.shopify.com/s/files/1/0905/0089/0960/files/'
  assign display_font = section.settings.display_font
  assign body_font = section.settings.body_font
  assign body_font_bold = body_font | font_modify: 'weight', 'bold'
  assign accent = section.settings.accent
  assign ig_handle = section.settings.instagram_handle | remove: '@' | strip

  if section.settings.hero_image != blank
    assign hero_src = section.settings.hero_image | image_url: width: 720
  else
    assign hero_src = cdn | append: 'aerobelle-lp3-hero-dorka.jpg?width=720'
  endif
  if section.settings.preview_poster != blank
    assign poster_src = section.settings.preview_poster | image_url: width: 920
  else
    assign poster_src = cdn | append: 'aerobelle-lp3-elonezet-borito.jpg?width=920'
  endif
  assign preview_video = section.settings.preview_video_url | default: 'https://cdn.shopify.com/s/files/1/0905/0089/0960/files/aerobelle-lp3-elonezet.mp4'
-%}

<style>
  {{ display_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_font_bold | font_face: font_display: 'swap' }}
  .ab-lp3{
    --ab-accent: {{ accent }};
    --ab-dark:#2B2B2B; --ab-cream:#F9F4F0; --ab-muted:#5E5852; --ab-line:#E6DDD4; --ab-white:#FFFFFF;
    --ab-display: {{ display_font.family }}, {{ display_font.fallback_families }};
    --ab-body: {{ body_font.family }}, {{ body_font.fallback_families }};
    background:var(--ab-cream); color:var(--ab-dark); font-family:var(--ab-body);
    font-size:16px; line-height:1.5; -webkit-font-smoothing:antialiased;
  }
  .ab-lp3 *,.ab-lp3 *::before,.ab-lp3 *::after{box-sizing:border-box}
  .ab-lp3 h1,.ab-lp3 h2,.ab-lp3 h3{font-family:var(--ab-display);font-weight:400;text-transform:uppercase;letter-spacing:0;margin:0;color:inherit}
  .ab-lp3 p{margin:0;text-transform:none}
  .ab-lp3 p::first-letter{text-transform:none}
  .ab-lp3 blockquote{margin:0;padding:0;border:0;font-style:normal;color:inherit;font-family:var(--ab-body);quotes:none;background:none}
  .ab-lp3 blockquote::before,.ab-lp3 blockquote::after{content:none}
  .ab-lp3 figure{margin:0}
  .ab-lp3 img,.ab-lp3 video{display:block;max-width:100%}
  .ab-lp3 a{color:inherit}
  .ab-wrap{max-width:1280px;margin:0 auto;padding:0 20px}
  .ab-accent{color:var(--ab-accent)}
  .ab-muted{color:var(--ab-muted)}
  .ab-pill{display:inline-block;padding:6px 12px;border-radius:999px;background:var(--ab-dark);color:var(--ab-cream);font-size:14px;font-weight:700;letter-spacing:.04em}
  .ab-btn{display:inline-flex;align-items:center;justify-content:center;min-height:56px;padding:0 26px;border:0;border-radius:14px;background:var(--ab-accent);color:var(--ab-dark);font-family:var(--ab-display);font-size:20px;letter-spacing:.04em;text-decoration:none;cursor:pointer;text-transform:uppercase;transition:transform .15s ease,filter .15s ease}
  .ab-btn:hover{filter:brightness(1.05)}
  .ab-btn:active{transform:translateY(1px)}
  .ab-btn:focus-visible,.ab-lp3 input:focus-visible,.ab-lp3 a:focus-visible{outline:3px solid var(--ab-dark);outline-offset:2px}
  .ab-on-dark .ab-btn:focus-visible,.ab-on-dark input:focus-visible,.ab-on-dark a:focus-visible{outline-color:var(--ab-cream)}

  /* Hero */
  .ab-hero{padding:24px 0 40px}
  .ab-hero .ab-wrap{display:flex;flex-direction:column;gap:22px}
  .ab-ring{align-self:center;width:212px;height:212px;border-radius:50%;padding:5px;background:var(--ab-accent);flex-shrink:0}
  .ab-ring img{width:100%;height:100%;border-radius:50%;border:5px solid var(--ab-cream);object-fit:cover}
  .ab-hero-text{display:flex;flex-direction:column;gap:20px}
  .ab-hero h1{font-size:38px;line-height:1.08}
  .ab-byline{font-size:15px;font-weight:700;color:var(--ab-muted);margin-top:12px}
  .ab-offer{display:flex;align-items:center;flex-wrap:wrap;gap:10px;font-size:17px;font-weight:700}
  .ab-hero-cta{width:100%}
  .ab-hero-form{display:none}

  /* Form */
  .ab-form{display:flex;flex-direction:column;gap:12px}
  .ab-form label.ab-label{font-size:14px;font-weight:700}
  .ab-row{display:flex;flex-direction:column;gap:10px}
  .ab-input{width:100%;height:56px;padding:0 16px;border-radius:12px;border:1px solid #C9BFB5;background:var(--ab-white);color:var(--ab-dark);font-size:16px;font-family:var(--ab-body);margin:0;box-shadow:none}
  .ab-consent{display:flex;gap:12px;align-items:flex-start;font-size:13px;line-height:1.5;color:var(--ab-muted);cursor:pointer}
  .ab-consent input{width:22px;height:22px;margin:0;flex-shrink:0;accent-color:var(--ab-accent)}
  .ab-consent a{text-decoration:underline}
  .ab-note{font-size:13px;line-height:1.5;color:var(--ab-muted)}
  .ab-error{padding:12px 14px;border-radius:10px;background:#FDE4D9;color:#7A2410;font-size:14px;font-weight:700}
  .ab-success{padding:20px;border-radius:14px;background:var(--ab-white);border:2px solid var(--ab-accent);display:flex;flex-direction:column;gap:6px}
  .ab-success strong{font-family:var(--ab-display);font-weight:400;font-size:24px;text-transform:uppercase;line-height:1.1}
  .ab-on-dark .ab-success{background:#3A3634;color:var(--ab-cream)}
  .ab-hp{position:absolute!important;left:-9999px!important;width:1px;height:1px;overflow:hidden}

  /* Preview + Dorka */
  .ab-intro{background:var(--ab-white);padding:36px 0}
  .ab-intro .ab-wrap{display:flex;flex-direction:column;gap:16px}
  .ab-kicker{font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--ab-muted)}
  .ab-video{position:relative;width:100%;aspect-ratio:1/1;border-radius:20px;overflow:hidden;background:var(--ab-dark)}
  .ab-video video{width:100%;height:100%;object-fit:cover}
  .ab-badge{position:absolute;right:12px;top:12px;padding:5px 10px;border-radius:8px;background:var(--ab-dark);color:var(--ab-cream);font-size:13px;font-weight:700}
  .ab-dorka{margin-top:8px;padding:22px 20px;background:var(--ab-cream);border-radius:18px;display:flex;flex-direction:column;gap:16px}
  .ab-dorka h2{font-size:23px;line-height:1.1}
  .ab-dorka .ab-sub{font-size:14px;color:var(--ab-muted);margin-top:2px}
  .ab-quote{font-size:15px;line-height:1.55}
  .ab-ig{align-self:flex-start;display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 14px;border:1px solid #C9BFB5;border-radius:999px;background:var(--ab-white);font-size:15px;font-weight:700;text-decoration:none}

  /* Cards */
  .ab-get{padding:40px 0 36px}
  .ab-get .ab-wrap{display:flex;flex-direction:column;gap:18px}
  .ab-get-head h2{font-size:30px;line-height:1.1}
  .ab-get-head p{font-size:16px;color:var(--ab-muted);margin-top:6px}
  .ab-cards{display:grid;grid-template-columns:1fr;gap:16px}
  .ab-card{background:var(--ab-white);border:1px solid var(--ab-line);border-radius:18px;overflow:hidden}
  .ab-pair{display:grid;grid-template-columns:1fr 1fr;gap:3px}
  .ab-pair figure{position:relative;margin:0;aspect-ratio:174/200}
  .ab-pair img{width:100%;height:100%;object-fit:cover}
  .ab-tag{position:absolute;left:10px;top:10px;padding:4px 9px;border-radius:999px;font-size:12px;font-weight:700;letter-spacing:.06em}
  .ab-tag--before{background:var(--ab-dark);color:var(--ab-cream)}
  .ab-tag--after{background:var(--ab-accent);color:var(--ab-dark)}
  .ab-card-body{padding:16px 18px;display:flex;flex-direction:column;gap:4px}
  .ab-card-body h3{font-family:var(--ab-body);text-transform:none;font-weight:700;font-size:18px;line-height:1.3}
  .ab-card-body p{font-size:14px;color:var(--ab-muted)}
  .ab-checks{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;font-size:14px;color:var(--ab-muted)}
  .ab-checks li{display:flex;gap:10px;align-items:flex-start}
  .ab-checks svg{flex-shrink:0;margin-top:2px}

  /* Testimonial */
  .ab-testi{padding:0 0 36px}
  .ab-testi-card{padding:22px;background:var(--ab-white);border:1px solid var(--ab-line);border-radius:18px;display:flex;flex-direction:column;gap:14px;max-width:760px;margin:0 auto}
  .ab-stars{font-size:18px;color:var(--ab-accent);letter-spacing:.1em}
  .ab-testi-card blockquote{margin:0;font-size:17px;line-height:1.5}
  .ab-person{display:flex;align-items:center;gap:12px}
  .ab-avatar{width:42px;height:42px;border-radius:50%;background:var(--ab-dark);color:var(--ab-cream);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px}
  .ab-person b{display:block;font-size:15px}
  .ab-person small{display:block;font-size:13px;color:var(--ab-muted)}

  /* Final CTA */
  .ab-final{padding:40px 0 44px;background:var(--ab-dark);color:var(--ab-cream)}
  .ab-final .ab-wrap{display:flex;flex-direction:column;gap:18px}
  .ab-final h2{font-size:32px;line-height:1.1}
  .ab-final .ab-input{background:#3A3634;border-color:#6E6862;color:var(--ab-cream)}
  .ab-final .ab-input::placeholder{color:#B5ACA3}
  .ab-final .ab-consent,.ab-final .ab-note{color:#D9D1C9}
  .ab-final .ab-consent a{color:var(--ab-cream)}

  @media (min-width:990px){
    .ab-wrap{padding:0 96px}
    .ab-hero{padding:40px 0 72px}
    .ab-hero .ab-wrap{flex-direction:row-reverse;align-items:center;gap:64px}
    .ab-ring{width:360px;height:360px;padding:7px}
    .ab-ring img{border-width:7px}
    .ab-hero-text{flex:1;display:flex;flex-direction:column;gap:26px}
    .ab-hero h1{font-size:60px;line-height:1.06}
    .ab-byline{font-size:17px;margin-top:0}
    .ab-offer{font-size:20px}
    .ab-hero-cta{display:none}
    .ab-hero-form{display:block;padding:24px;background:var(--ab-white);border:1px solid var(--ab-line);border-radius:20px}
    .ab-row{flex-direction:row}
    .ab-row .ab-btn{flex-shrink:0}
    .ab-intro{padding:72px 0}
    .ab-intro .ab-wrap{flex-direction:row;align-items:center;gap:64px}
    .ab-intro .ab-kicker{display:none}
    .ab-video{width:460px;flex-shrink:0;border-radius:24px}
    .ab-dorka{margin:0;padding:0;background:none;flex:1;gap:22px}
    .ab-dorka h2{font-size:34px}
    .ab-dorka .ab-sub{font-size:16px}
    .ab-quote{font-size:18px;line-height:1.6}
    .ab-get{padding:72px 0}
    .ab-get .ab-wrap{gap:32px}
    .ab-get-head{display:flex;align-items:baseline;justify-content:space-between;gap:24px}
    .ab-get-head h2{font-size:44px}
    .ab-get-head p{font-size:19px;margin:0}
    .ab-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
    .ab-pair figure{aspect-ratio:169/220}
    .ab-checks{flex-direction:row;gap:32px;font-size:15px}
    .ab-testi{padding:0 0 72px}
    .ab-testi-card{padding:32px 36px;align-items:center;text-align:center}
    .ab-testi-card blockquote{font-size:22px}
    .ab-person{text-align:left}
    .ab-final{padding:64px 0}
    .ab-final .ab-wrap{align-items:center}
    .ab-final h2{font-size:44px}
    .ab-final .ab-form{width:100%;max-width:640px}
    .ab-final .ab-note{text-align:center}
  }
  @media (prefers-reduced-motion:reduce){.ab-btn{transition:none}}
</style>

{%- capture check_icon -%}
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2B2B2B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
{%- endcapture -%}

{%- comment -%} Közös űrlap-tartalom két példányban (hero és alsó) {%- endcomment -%}
{%- capture privacy_link -%}<a href="{{ section.settings.privacy_url | default: '/policies/privacy-policy' }}" target="_blank" rel="noopener">Adatkezelési tájékoztató</a>{%- endcapture -%}

<div class="ab-lp3" id="ab-lp3-{{ section.id }}">

  {%- comment -%} HERO {%- endcomment -%}
  <section class="ab-hero" aria-labelledby="ab-h1-{{ section.id }}">
    <div class="ab-wrap">
      <div class="ab-ring">
        <img src="{{ hero_src }}" alt="Dorka, fodrász, mosolyog" width="360" height="360" fetchpriority="high">
      </div>
      <div class="ab-hero-text">
        <div>
          <h1 id="ab-h1-{{ section.id }}">{{ section.settings.headline_1 }} <span class="ab-accent">{{ section.settings.headline_2 }}</span></h1>
          <p class="ab-byline">{{ section.settings.byline }}</p>
        </div>
        <p class="ab-offer"><span class="ab-pill">{{ section.settings.offer_pill }}</span> {{ section.settings.offer_text }}</p>
        <a href="#ab-signup-{{ section.id }}" class="ab-btn ab-hero-cta">{{ section.settings.button_label }}</a>

        <div class="ab-hero-form">
          {%- form 'customer', id: 'ab-lp3-form-hero', class: 'ab-form', data-ab-form: '' -%}
            {%- if form.posted_successfully? -%}
              <div class="ab-success" role="status" tabindex="-1" data-ab-success>
                <strong>{{ section.settings.success_title }}</strong>
                <span>{{ section.settings.success_text }}</span>
              </div>
            {%- else -%}
              {%- if form.errors -%}
                <p class="ab-error" role="alert">{%- if form.errors contains 'email' -%}{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}{%- else -%}Valami hiba történt. Kérjük, próbáld újra.{%- endif -%}</p>
              {%- endif -%}
              <input type="hidden" name="contact[tags]" value="{{ section.settings.customer_tags }}" data-ab-tags>
              <label class="ab-label" for="ab-email-hero">E-mail-cím</label>
              <div class="ab-row">
                <input class="ab-input" id="ab-email-hero" type="email" name="contact[email]" placeholder="pl. anna@gmail.com" autocomplete="email" autocapitalize="off" spellcheck="false" required>
                <button type="submit" class="ab-btn">{{ section.settings.button_label }}</button>
              </div>
              <label class="ab-consent">
                <input type="checkbox" required>
                <span>{{ section.settings.consent_text }} {{ privacy_link }}</span>
              </label>
              <p class="ab-note">{{ section.settings.form_note }}</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ELŐNÉZET + DORKA {%- endcomment -%}
  <section class="ab-intro" aria-labelledby="ab-dorka-{{ section.id }}">
    <div class="ab-wrap">
      <p class="ab-kicker">Belenézel?</p>
      <div class="ab-video">
        <video src="{{ preview_video }}" poster="{{ poster_src }}" muted loop playsinline preload="none" aria-label="20 másodperces előnézet Dorka oktatóvideóiból" data-ab-autoplay></video>
        <span class="ab-badge">0:20 előnézet</span>
      </div>
      <div class="ab-dorka">
        <div>
          <h2 id="ab-dorka-{{ section.id }}">Szia, Dorka vagyok</h2>
          <p class="ab-sub">{{ section.settings.dorka_sub }}</p>
        </div>
        <p class="ab-quote">{{ section.settings.dorka_quote }}</p>
        {%- if ig_handle != blank -%}
          <a class="ab-ig" href="https://www.instagram.com/{{ ig_handle }}/" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2B2B2B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.8" fill="#2B2B2B"/></svg>
            @{{ ig_handle }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- comment -%} MIT KAPSZ {%- endcomment -%}
  <section class="ab-get" aria-labelledby="ab-get-{{ section.id }}">
    <div class="ab-wrap">
      <div class="ab-get-head">
        <h2 id="ab-get-{{ section.id }}">Mit kapsz?</h2>
        <p>3 videó – vizes hajtól a kész frizuráig.</p>
      </div>
      <div class="ab-cards">
        {%- assign cards = 'furtok|volumen|egyenes' | split: '|' -%}
        {%- for key in cards -%}
          {%- case key -%}
            {%- when 'volumen' -%}
              {%- assign c_title = '2. Volumenes beszárítás körkefével' -%}
              {%- assign c_meta = 'kb. 4 perc · dús, lendületes haj' -%}
              {%- assign c_after = 'Utána: dús, volumenes haj' -%}
            {%- when 'furtok' -%}
              {%- assign c_title = '1. Fürtök a göndörítő fejekkel' -%}
              {%- assign c_meta = 'kb. 2,5 perc · balra és jobbra csavarva' -%}
              {%- assign c_after = 'Utána: kész fürtök' -%}
            {%- when 'egyenes' -%}
              {%- assign c_title = '3. Sima, fényes haj a laposkefével' -%}
              {%- assign c_meta = 'kb. 3,5 perc · simítás, rendezett végek' -%}
              {%- assign c_after = 'Utána: sima, fényes haj' -%}
          {%- endcase -%}
          <article class="ab-card">
            <div class="ab-pair">
              <figure>
                <img src="{{ cdn }}aerobelle-lp3-{{ key }}-elotte.jpg?width=520" alt="Előtte: vizes haj" width="360" height="414" loading="lazy">
                <span class="ab-tag ab-tag--before">ELŐTTE</span>
              </figure>
              <figure>
                <img src="{{ cdn }}aerobelle-lp3-{{ key }}-utana.jpg?width=520" alt="{{ c_after }}" width="360" height="414" loading="lazy">
                <span class="ab-tag ab-tag--after">UTÁNA</span>
              </figure>
            </div>
            <div class="ab-card-body">
              <h3>{{ c_title }}</h3>
              <p>{{ c_meta }}</p>
            </div>
          </article>
        {%- endfor -%}
      </div>
      <ul class="ab-checks">
        <li>{{ check_icon }}A gyors előszárítás mindegyikben benne van.</li>
        <li>{{ check_icon }}{{ section.settings.product_note }}</li>
      </ul>
    </div>
  </section>

  {%- comment -%} VÉLEMÉNY {%- endcomment -%}
  <section class="ab-testi" aria-label="Vásárlói vélemény">
    <div class="ab-wrap">
      <figure class="ab-testi-card" style="margin:0 auto">
        <div class="ab-stars" aria-label="5 csillag" role="img">★★★★★</div>
        <blockquote>„{{ section.settings.testimonial_text }}”</blockquote>
        <figcaption class="ab-person">
          {%- if section.settings.testimonial_avatar != blank -%}<img class="ab-avatar" src="{{ cdn }}{{ section.settings.testimonial_avatar }}?width=120" alt="{{ section.settings.testimonial_name | escape }}" width="42" height="42" style="object-fit:cover;padding:0">{%- else -%}<div class="ab-avatar" aria-hidden="true">{{ section.settings.testimonial_initials }}</div>{%- endif -%}
          <div><b>{{ section.settings.testimonial_name }}</b><small>vásárló</small></div>
        </figcaption>
      </figure>
    </div>
  </section>

  {%- comment -%} ALSÓ FELIRATKOZÁS {%- endcomment -%}
  <section class="ab-final ab-on-dark" id="ab-signup-{{ section.id }}" aria-labelledby="ab-final-{{ section.id }}">
    <div class="ab-wrap">
      <h2 id="ab-final-{{ section.id }}">{{ section.settings.final_heading }}</h2>
      {%- form 'customer', id: 'ab-lp3-form-final', class: 'ab-form', data-ab-form: '' -%}
        {%- if form.posted_successfully? -%}
          <div class="ab-success" role="status" tabindex="-1" data-ab-success>
            <strong>{{ section.settings.success_title }}</strong>
            <span>{{ section.settings.success_text }}</span>
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <p class="ab-error" role="alert">{%- if form.errors contains 'email' -%}{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}{%- else -%}Valami hiba történt. Kérjük, próbáld újra.{%- endif -%}</p>
          {%- endif -%}
          <input type="hidden" name="contact[tags]" value="{{ section.settings.customer_tags }}" data-ab-tags>
          <label class="ab-label" for="ab-email-final">E-mail-cím</label>
          <div class="ab-row">
            <input class="ab-input" id="ab-email-final" type="email" name="contact[email]" placeholder="pl. anna@gmail.com" autocomplete="email" autocapitalize="off" spellcheck="false" required>
            <button type="submit" class="ab-btn">{{ section.settings.button_label }}</button>
          </div>
          <label class="ab-consent">
            <input type="checkbox" required>
            <span>{{ section.settings.consent_text }} {{ privacy_link }}</span>
          </label>
          <p class="ab-note">{{ section.settings.form_note }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </section>
</div>

<script>
  (function () {
    var root = document.getElementById('ab-lp3-{{ section.id }}');
    if (!root) return;

    // Forrás-címke (utm_source) a feliratkozóhoz, pl. lp3-src-facebook
    try {
      var p = new URLSearchParams(window.location.search);
      var src = (p.get('utm_source') || '').toLowerCase().replace(/[^a-z0-9_-]/g, '').slice(0, 30);
      if (src) {
        root.querySelectorAll('[data-ab-tags]').forEach(function (el) {
          el.value = el.value + ', lp3-src-' + src;
        });
      }
    } catch (e) {}

    // Sikeres feliratkozás: fókusz + GTM esemény
    var ok = root.querySelector('[data-ab-success]');
    if (ok) {
      try { ok.focus({ preventScroll: false }); } catch (e) {}
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'lp3_signup' });
      if (typeof window.fbq === 'function') { window.fbq('track', 'Lead', { content_name: 'LP3 oktatovideok' }); }
    }

    // Előnézeti videó: csak látható állapotban fut (adatforgalom-kímélő)
    var v = root.querySelector('[data-ab-autoplay]');
    if (v && 'IntersectionObserver' in window) {
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) { v.controls = true; }
      else {
        new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { v.preload = 'auto'; var pr = v.play(); if (pr && pr.catch) pr.catch(function () { v.controls = true; }); }
            else { v.pause(); }
          });
        }, { threshold: 0.35 }).observe(v);
      }
    } else if (v) { v.controls = true; }
  })();
</script>

