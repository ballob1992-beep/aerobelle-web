<div class="abh">

<section class="wrap" style="padding-top:40px;padding-bottom:12px;display:flex;flex-direction:column;gap:14px;max-width:900px">
  <h1 class="h-xl">Miben segíthetünk?</h1>
  <p style="font-size:17px;max-width:640px">Itt minden kérdésre őszinte választ kapsz. Ha mégsem találod, amit keresel, hívj fel minket – egy ember veszi fel, nem egy gép.</p>
  <label for="faq-search" style="font-size:14px;font-weight:500">Keresés a kérdések között</label>
  <input id="faq-search" type="search" placeholder="pl. garancia, hosszú haj, utánvét" style="height:52px;border-radius:12px;border:1.5px solid #2B2B2B;padding:0 16px;font-size:16px;font-family:inherit;background:#FFFFFF;margin-top:-6px;color:#2B2B2B">
