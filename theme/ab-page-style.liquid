<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
<style>
.abh{font-family:'Space Grotesk',system-ui,sans-serif;color:#2B2B2B;background:#F9F4F0;line-height:1.5}
.abh label a,.abh p a{padding:0 !important;margin:0 !important;display:inline !important}
.abh *{box-sizing:border-box}
.abh a{color:#2B2B2B}
.abh h1 span,.abh h2 span{text-transform:uppercase !important}
.abh h1,.abh h2,.abh h3{font-family:'Anton',Impact,sans-serif !important;font-weight:400 !important;text-transform:uppercase !important;letter-spacing:.3px !important;margin:0 !important;line-height:1.04 !important;color:inherit !important}
.abh p{margin:0}
.abh .wrap{max-width:1200px;margin:0 auto;padding-left:20px;padding-right:20px}
.abh .btn{display:inline-flex;align-items:center;justify-content:center;min-height:58px;padding:0 32px;border-radius:999px;background:#FE6C3B;color:#2B2B2B !important;font-weight:700;font-size:16px;letter-spacing:.3px;text-transform:uppercase;text-decoration:none;border:0;font-family:inherit;cursor:pointer;text-align:center}
.abh .btn:hover{background:#FF8A5E}
.abh .eyebrow{font-size:13px;font-weight:700;letter-spacing:1.6px;color:#B8461F;text-transform:uppercase}
.abh .grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr));gap:48px;align-items:center}
.abh .grid3{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:20px}
.abh .grid4{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:18px}
.abh .sec{padding-top:72px;padding-bottom:72px}
.abh .h-xl{font-size:clamp(38px,6vw,60px)}
.abh .h-l{font-size:clamp(32px,4.5vw,50px)}
.abh .mono{flex:none;width:44px;height:44px;border-radius:50%;background:#2B2B2B;color:#F9F4F0;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px}
.abh .stars{color:#FE6C3B;letter-spacing:1px}
.abh .card{background:#FFFFFF;border-radius:18px;padding:24px;display:flex;flex-direction:column;gap:12px}
.abh .ba{position:relative}.abh .ba img{width:100%;height:300px;object-fit:cover;display:block}
.abh .tag{position:absolute;left:10px;top:10px;font-size:11px;font-weight:700;padding:4px 8px;border-radius:6px}
.abh details{border-bottom:1px solid #E3D9D0}
.abh summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:62px;font-weight:700;font-size:17px}
.abh summary::-webkit-details-marker{display:none}
.abh details[open] summary .pm{transform:rotate(45deg)}
.abh .pm{transition:transform .2s;font-size:22px;line-height:1}
.abh details p{margin:0 0 18px;line-height:1.55}
.abh video{background:#000;display:block;width:100%}
.abh .cmp td,.abh .cmp th{padding:13px 12px;text-align:left;vertical-align:top}
.abh .cmp tr+tr{border-top:1px solid #4A4A4A}
.abh .cmp .me{background:rgba(254,108,59,.16)}
.abh .offer li{display:flex;justify-content:space-between;gap:16px;border-bottom:1px solid #EFE7E0;padding-bottom:10px}
.abh .offer li:last-child{border-bottom:0}
.abh input[type=email]{flex:1 1 240px;height:58px;border-radius:999px;border:1.5px solid #2B2B2B;padding:0 22px;font-size:16px;font-family:inherit;background:#FFFFFF;color:#2B2B2B}
@media (max-width:749px){.abh .sec{padding-top:52px;padding-bottom:52px}.abh .ba img{height:220px}.abh .hide-m{display:none}}
</style>
