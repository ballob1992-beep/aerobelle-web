{%- comment -%} Hajkódex e-book kártyák önálló vásárlással. Paraméter: exclude (handle, opcionális) {%- endcomment -%}
{%- assign cdn = 'https://cdn.shopify.com/s/files/1/0905/0089/0960/files/' -%}
<style>
.abk-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.abk-card{background:#FFFFFF;border:1px solid #E3D9D0;border-radius:18px;padding:16px;display:flex;flex-direction:column;gap:10px}
.abk-card img{width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:10px;display:block}
.abk-card .btn{min-height:48px;font-size:14px;padding:0 18px;width:100%}
.abk-card .btn[disabled]{opacity:.6}
@media (max-width:749px){.abk-grid{grid-template-columns:1fr}.abk-card{flex-direction:row;align-items:flex-start}.abk-card>a:first-child{flex:none;width:96px}.abk-card .abk-body{flex:1;display:flex;flex-direction:column;gap:8px}}
@media (min-width:750px){.abk-card .abk-body{display:flex;flex-direction:column;gap:10px;flex:1}}
</style>
<div class="abk-grid">
  {%- unless exclude == 'hajkodex-hajmitoszok-ebook' -%}
  <div class="abk-card">
    <a href="/products/hajkodex-hajmitoszok-ebook"><img src="{{ cdn }}aerobelle-ebook-hajmitoszok.jpg?width=600" alt="Hajmítoszok e-book borító" loading="lazy"></a>
    <div class="abk-body">
      <div><a href="/products/hajkodex-hajmitoszok-ebook" style="text-decoration:none"><b style="font-size:17px">Hajmítoszok</b></a><div style="font-size:14px;color:#5C534C;margin-top:4px">52 tévhit a hajról – és ami valójában igaz. PDF, 70 oldal.</div></div>
      <div style="font-weight:700;font-size:17px;margin-top:auto">2 990 Ft</div>
      <button type="button" class="btn" data-abk-add="53832538521936">Kosárba</button>
    </div>
  </div>
  {%- endunless -%}
  {%- unless exclude == 'hajkodex-hajpszichologia-ebook' -%}
  <div class="abk-card">
    <a href="/products/hajkodex-hajpszichologia-ebook"><img src="{{ cdn }}aerobelle-ebook-hajpszichologia.jpg?width=600" alt="Hajpszichológia e-book borító" loading="lazy"></a>
    <div class="abk-body">
      <div><a href="/products/hajkodex-hajpszichologia-ebook" style="text-decoration:none"><b style="font-size:17px">Hajpszichológia</b></a><div style="font-size:14px;color:#5C534C;margin-top:4px">52 gondolat arról, miért jelent többet a hajunk, mint gondolnánk. PDF, 43 oldal.</div></div>
      <div style="font-weight:700;font-size:17px;margin-top:auto">2 990 Ft</div>
      <button type="button" class="btn" data-abk-add="53832544026960">Kosárba</button>
    </div>
  </div>
  {%- endunless -%}
  {%- unless exclude == 'hajkodex-hajkultura-ebook' -%}
  <div class="abk-card">
    <a href="/products/hajkodex-hajkultura-ebook"><img src="{{ cdn }}aerobelle-ebook-hajkultura.jpg?width=600" alt="Hajkultúra e-book borító" loading="lazy"></a>
    <div class="abk-body">
      <div><a href="/products/hajkodex-hajkultura-ebook" style="text-decoration:none"><b style="font-size:17px">Hajkultúra</b></a><div style="font-size:14px;color:#5C534C;margin-top:4px">5000 év története a hajunkról – és amit elárul rólunk. PDF, 82 oldal.</div></div>
      <div style="font-weight:700;font-size:17px;margin-top:auto">2 990 Ft</div>
      <button type="button" class="btn" data-abk-add="53832548974928">Kosárba</button>
    </div>
  </div>
  {%- endunless -%}
</div>
<script>
(function () {
  if (window.abkInit) return; window.abkInit = true;
  document.addEventListener('click', function (e) {
    var b = e.target.closest ? e.target.closest('[data-abk-add]') : null; if (!b) return;
    b.disabled = true; var t = b.textContent; b.textContent = 'Egy pillanat…';
    fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ items: [ { id: parseInt(b.getAttribute('data-abk-add'), 10), quantity: 1 } ] }) })
      .then(function (r) { if (!r.ok) throw new Error('add'); window.location.href = '/cart'; })
      .catch(function () { b.disabled = false; b.textContent = 'Hiba – próbáld újra'; });
  });
})();
</script>
